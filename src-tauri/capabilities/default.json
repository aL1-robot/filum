{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://192.168.*" },
        { "url": "http://192.168.*/**" },
        { "url": "http://192.168.*:*/*" },
        { "url": "http://10.*" },
        { "url": "http://10.*/**" },
        { "url": "http://10.*:*/*" },
        { "url": "http://172.16.*" },
        { "url": "http://172.16.*/**" },
        { "url": "http://172.16.*:*/*" },
        { "url": "http://172.17.*" },
        { "url": "http://172.17.*/**" },
        { "url": "http://172.17.*:*/*" },
        { "url": "http://172.18.*" },
        { "url": "http://172.18.*/**" },
        { "url": "http://172.18.*:*/*" },
        { "url": "http://172.19.*" },
        { "url": "http://172.19.*/**" },
        { "url": "http://172.19.*:*/*" },
        { "url": "http://172.20.*" },
        { "url": "http://172.20.*/**" },
        { "url": "http://172.20.*:*/*" },
        { "url": "http://172.21.*" },
        { "url": "http://172.21.*/**" },
        { "url": "http://172.21.*:*/*" },
        { "url": "http://172.22.*" },
        { "url": "http://172.22.*/**" },
        { "url": "http://172.22.*:*/*" },
        { "url": "http://172.23.*" },
        { "url": "http://172.23.*/**" },
        { "url": "http://172.23.*:*/*" },
        { "url": "http://172.24.*" },
        { "url": "http://172.24.*/**" },
        { "url": "http://172.24.*:*/*" },
        { "url": "http://172.25.*" },
        { "url": "http://172.25.*/**" },
        { "url": "http://172.25.*:*/*" },
        { "url": "http://172.26.*" },
        { "url": "http://172.26.*/**" },
        { "url": "http://172.26.*:*/*" },
        { "url": "http://172.27.*" },
        { "url": "http://172.27.*/**" },
