        { "url": "http://172.29.*:*/*" },
        { "url": "http://172.30.*" },
        { "url": "http://172.30.*/**" },
        { "url": "http://172.30.*:*/*" },
        { "url": "http://172.31.*" },
        { "url": "http://172.31.*/**" },
        { "url": "http://172.31.*:*/*" },
        { "url": "http://localhost" },
        { "url": "http://localhost/**" },
        { "url": "http://localhost:*/*" }
      ]
    },
    "websocket:default",
    "store:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "clipboard-manager:allow-write-text"
  ]
